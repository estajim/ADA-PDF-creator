# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ada_pdf:secret@postgres:5432/ada_pdf

# ─── Redis / Celery ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Anthropic ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Storage ────────────────────────────────────────────────────────────────
STORAGE_ROOT=/app/storage
MAX_FILE_SIZE_MB=100

# ─── veraPDF ────────────────────────────────────────────────────────────────
VERAPDF_CLI_PATH=/opt/verapdf/verapdf

# ─── OCR ────────────────────────────────────────────────────────────────────
# Options: surya | paddleocr
OCR_PRIMARY=surya
SURYA_MODEL_DIR=/app/models/surya

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10

# ─── Security (optional) ────────────────────────────────────────────────────
# CLAMAV_SOCKET_PATH=/var/run/clamav/clamd.ctl

# ─── Feature flags ──────────────────────────────────────────────────────────
WEASYPRINT_ENABLED=true
REPORTLAB_FALLBACK=true
WEASYPRINT_TIMEOUT_SECONDS=120

# ─── Pipeline ───────────────────────────────────────────────────────────────
# Options: kmeans | gap
COLUMN_ALGORITHM=gap
CELERY_TASK_MAX_RETRIES=3
